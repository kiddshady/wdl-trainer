{
  "name": "wdl-trainer",
  "private": true,
  "version": "0.4.1",
  "description": "A Penumbra desktop trainer for Watch Dogs Legion (single-player).",
  "author": "Kidd Shady",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "gen:icon": "node scripts/gen-icon.mjs",
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^2.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^2.1.8",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.kiddshady.wdltrainer",
    "productName": "wdl-trainer",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "kiddshady",
      "repo": "wdl-trainer",
      "releaseType": "release"
    },
    "files": [
      "**/*",
      "build/icon.png",
      "build/icon.ico",
      "!dist/**",
      "!renderer/src/**",
      "!mockup/**",
      "!cheat-engine/**",
      "!spike.mjs",
      "!test.mjs",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
